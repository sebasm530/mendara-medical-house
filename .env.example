# Variables privadas del servidor. Nunca usar NEXT_PUBLIC_ para credenciales.
GOOGLE_SHEETS_ID=
# Local: ruta al JSON privado, relativa a la raíz del proyecto.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
# Hosting o Vercel: JSON completo de la cuenta de servicio en una variable privada.
# Tiene prioridad sobre GOOGLE_APPLICATION_CREDENTIALS; no subir el archivo secrets/.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcional: nombre exacto de la pestaña. Sin definir, se utiliza la primera.
GOOGLE_SHEETS_TAB=
# Opcional: false deshabilita expresamente el formulario.
WAITLIST_FORM_ENABLED=false
# Notificación opcional después del guardado. Su ausencia no deshabilita Sheets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=
# Política oficial HTTPS y aprobación del responsable, pendientes.
VISIT_PRIVACY_POLICY_URL=
VISIT_PRIVACY_APPROVED=false
